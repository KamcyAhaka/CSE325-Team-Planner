@page "/boards/{boardId}"

@layout DashboardLayout

@rendermode InteractiveServer

@attribute [Authorize]

@using System.Security.Claims

@inject BoardService BoardService
@inject TaskService TaskService
@inject ProjectService ProjectService
@inject ProjectMemberService ProjectMemberService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UiActionRunner Runner
@inject NavigationManager NavigationManager

<PageTitle>Board Workspace</PageTitle>

<DashboardHeader Title="Board Workspace" Subtitle="Manage the tasks for this board." />

<div class="board-workspace">
    @if (boardNotFound)
    {
        <div class="project-empty">Board not found.</div>
    }
    else if (noAccess)
    {
        <div class="project-empty">You don't have access to this board.</div>
    }
    else if (board is null)
    {
        <div class="project-empty">Loading board...</div>
    }
    else
    {
        <div class="workspace-top-row">
            <a href="/projects/@board.ProjectId" class="back-link">
                <span class="icon icon-arrow-left icon-sm"></span>
                Back to Project
            </a>
        </div>

        @if (editingBoard)
        {
            <div class="board-header">
                <h1>Edit Board</h1>

                <EditForm Model="@editBoard"
                          OnValidSubmit="@UpdateBoard"
                          FormName="edit-board"
                          Class="form-card">

                    <DataAnnotationsValidator />

                    <ValidationSummary class="form-validation" />

                    <div class="form-field">
                        <label for="editBoardName" class="form-label">Board Name</label>
                        <LiveInputText id="editBoardName"
                                       class="form-input"
                                       @bind-Value="editBoard.Name" />
                        <ValidationMessage For="() => editBoard.Name" />
                    </div>

                    <div class="form-field">
                        <label for="editBoardDescription" class="form-label">Description</label>
                        <LiveInputTextArea id="editBoardDescription"
                                           class="form-input form-textarea"
                                           @bind-Value="editBoard.Description" />
                        <ValidationMessage For="() => editBoard.Description" />
                    </div>

                    <div class="card-actions">
                        <SubmitButton Text="Save Changes"
                                      Class="btn btn-primary card-action-btn"
                                      IsBusy="@savingBoard" />
                        <button type="button"
                                class="btn btn-outline-secondary card-action-btn"
                                disabled="@savingBoard"
                                @onclick="CancelEditBoard">
                            Cancel
                        </button>
                    </div>

                </EditForm>
            </div>
        }
        else if (confirmingDeleteBoard)
        {
            <div class="board-header">
                <h1>@board.Name</h1>

                <p>Delete this board? Its tasks will be deleted too.</p>

                <div class="card-confirm">
                    <button type="button"
                            class="btn btn-danger card-action-btn"
                            disabled="@deletingBoard"
                            @onclick="DeleteBoard">
                        @(deletingBoard ? "Deleting..." : "Yes, delete")
                    </button>
                    <button type="button"
                            class="btn btn-outline-secondary card-action-btn"
                            disabled="@deletingBoard"
                            @onclick="CancelDeleteBoard">
                        No
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="board-header">
                <h1>@board.Name</h1>

                @if (!string.IsNullOrEmpty(board.Description))
                {
                    <p>@board.Description</p>
                }

                <div class="card-actions">
                    <button type="button"
                            class="btn btn-outline-secondary card-action-btn"
                            @onclick="StartEditBoard">
                        Edit
                    </button>
                    <button type="button"
                            class="btn btn-danger card-action-btn"
                            @onclick="StartDeleteBoard">
                        Delete
                    </button>
                </div>
            </div>
        }

        <EditForm Model="@newTask"
                  OnValidSubmit="@CreateTask"
                  FormName="create-task"
                  Class="form-card board-task-form">

            <DataAnnotationsValidator />

            <div class="form">
                <h2 class="form-title">Create Task</h2>

                <ValidationSummary class="form-validation" />

                <div class="form-field">
                    <label for="taskTitle" class="form-label">Task Title</label>
                    <LiveInputText id="taskTitle"
                                   class="form-input"
                                   @bind-Value="newTask.Title" />
                    <ValidationMessage For="() => newTask.Title" />
                </div>

                <div class="form-field">
                    <label for="taskDescription" class="form-label">Description</label>
                    <LiveInputTextArea id="taskDescription"
                                       class="form-input form-textarea"
                                       @bind-Value="newTask.Description" />
                    <ValidationMessage For="() => newTask.Description" />
                </div>

                <div class="form-field board-due-date-field">
                    <label for="hasDueDate" class="form-label">
                        <input type="checkbox" id="hasDueDate" @bind="hasDueDate" />
                        Set a due date
                    </label>

                    @if (hasDueDate)
                    {
                        <InputDate id="taskDueDate"
                                   class="form-input"
                                   @bind-Value="dueDate" />
                    }
                </div>

                <SubmitButton Text="Create Task" IsBusy="@saving" />
            </div>
        </EditForm>

        <div class="board-columns">
            @foreach (var column in Columns)
            {
                var columnTasks = tasks.Where(t => t.Status == column.Status).ToList();

                <section class="board-column">
                    <header class="board-column-header">
                        <h2>@column.Label</h2>
                        <span class="board-count">@columnTasks.Count</span>
                    </header>

                    @if (columnTasks.Count == 0)
                    {
                        <p class="board-column-empty">No tasks here.</p>
                    }

                    @foreach (var task in columnTasks)
                    {
                        if (editingTaskId == task.Id)
                        {
                            <article class="board-task-card">
                                <h3>Edit Task</h3>

                                <EditForm Model="@editTask"
                                          OnValidSubmit="@UpdateTask"
                                          FormName="edit-task">

                                    <DataAnnotationsValidator />

                                    <ValidationSummary class="form-validation" />

                                    <div class="form-field">
                                        <label for="editTaskTitle" class="form-label">Task Title</label>
                                        <LiveInputText id="editTaskTitle"
                                                       class="form-input"
                                                       @bind-Value="editTask.Title" />
                                        <ValidationMessage For="() => editTask.Title" />
                                    </div>

                                    <div class="form-field">
                                        <label for="editTaskDescription" class="form-label">Description</label>
                                        <LiveInputTextArea id="editTaskDescription"
                                                           class="form-input form-textarea"
                                                           @bind-Value="editTask.Description" />
                                        <ValidationMessage For="() => editTask.Description" />
                                    </div>

                                    <div class="form-field board-due-date-field">
                                        <label for="editHasDueDate" class="form-label">
                                            <input type="checkbox" id="editHasDueDate" @bind="editHasDueDate" />
                                            Set a due date
                                        </label>

                                        @if (editHasDueDate)
                                        {
                                            <InputDate id="editTaskDueDate"
                                                       class="form-input"
                                                       @bind-Value="editDueDate" />
                                        }
                                    </div>

                                    <div class="form-field">
                                        <label for="editTaskStatus" class="form-label">Status</label>
                                        <select id="editTaskStatus"
                                                class="form-input"
                                                @bind="editTask.Status">
                                            <option value="@ProjectTaskStatus.ToDo">To Do</option>
                                            <option value="@ProjectTaskStatus.InProgress">In Progress</option>
                                            <option value="@ProjectTaskStatus.Done">Done</option>
                                        </select>
                                    </div>

                                    <div class="card-actions">
                                        <SubmitButton Text="Save Changes"
                                                      Class="btn btn-primary card-action-btn"
                                                      IsBusy="@saving" />
                                        <button type="button"
                                                class="btn btn-outline-secondary card-action-btn"
                                                disabled="@saving"
                                                @onclick="CancelEditTask">
                                            Cancel
                                        </button>
                                    </div>

                                </EditForm>
                            </article>
                        }
                        else if (deletingTaskId == task.Id)
                        {
                            <article class="board-task-card">
                                <h3>@task.Title</h3>

                                <p>Delete this task?</p>

                                <div class="card-confirm">
                                    <button type="button"
                                            class="btn btn-danger card-action-btn"
                                            disabled="@deletingTask"
                                            @onclick="DeleteTask">
                                        @(deletingTask ? "Deleting..." : "Yes, delete")
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-secondary card-action-btn"
                                            disabled="@deletingTask"
                                            @onclick="CancelDeleteTask">
                                        No
                                    </button>
                                </div>
                            </article>
                        }
                        else
                        {
                            <article class="board-task-card">
                                <h3>@task.Title</h3>

                                @if (!string.IsNullOrEmpty(task.Description))
                                {
                                    <p>@task.Description</p>
                                }

                                @if (task.DueDate is not null)
                                {
                                    <span class="board-task-due">
                                        Due @task.DueDate.Value.ToLocalTime().ToString("M/d/yyyy")
                                    </span>
                                }

                                <div class="board-task-actions">
                                    @foreach (var target in column.Moves)
                                    {
                                        <button type="button"
                                                class="btn btn-outline-secondary board-task-move-btn"
                                                disabled="@saving"
                                                @onclick="() => UpdateTaskStatus(task.Id, target)">
                                            Move to @GetStatusLabel(target)
                                        </button>
                                    }
                                </div>

                                <div class="board-task-actions">
                                    <button type="button"
                                            class="btn btn-outline-secondary card-action-btn"
                                            @onclick="() => StartEditTask(task)">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger card-action-btn"
                                            @onclick="() => StartDeleteTask(task)">
                                        Delete
                                    </button>
                                </div>
                            </article>
                        }
                    }
                </section>
            }
        </div>
    }

    <ToastHost />
</div>

@code {
    [Parameter]
    public string boardId { get; set; } = string.Empty;

    private Board? board;
    private List<ProjectTask> tasks = new();
    private bool boardNotFound;
    private bool noAccess;
    private bool saving;
    private ProjectTask newTask = new();
    private bool hasDueDate;
    private DateTime dueDate = DateTime.Today;
    private string userId = string.Empty;

    private string? editingTaskId;
    private ProjectTask editTask = new();
    private bool editHasDueDate;
    private DateTime editDueDate = DateTime.Today;

    private string? deletingTaskId;
    private bool deletingTask;

    private bool editingBoard;
    private Board editBoard = new();
    private bool savingBoard;

    private bool confirmingDeleteBoard;
    private bool deletingBoard;

    private static readonly TaskColumn[] Columns =
    [
        new("To Do", ProjectTaskStatus.ToDo,
            [ProjectTaskStatus.InProgress, ProjectTaskStatus.Done]),
        new("In Progress", ProjectTaskStatus.InProgress,
            [ProjectTaskStatus.ToDo, ProjectTaskStatus.Done]),
        new("Done", ProjectTaskStatus.Done,
            [ProjectTaskStatus.ToDo, ProjectTaskStatus.InProgress]),
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? string.Empty;

        board = await BoardService.GetBoardByIdAsync(boardId);

        if (board is null)
        {
            boardNotFound = true;
            return;
        }

        var project = await ProjectService.GetProjectByIdAsync(board.ProjectId);
        var members = await ProjectMemberService.GetMembersByProjectAsync(board.ProjectId);

        noAccess = project is null
            || (project.OwnerId != userId && !members.Any(m => m.UserId == userId));

        if (noAccess)
        {
            return;
        }

        newTask.ProjectId = board.ProjectId;
        newTask.BoardId = board.Id;
        newTask.OwnerId = userId;
        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        if (board is not null)
        {
            tasks = await TaskService.GetTasksByBoardAsync(board.Id);
        }
    }

    private async Task CreateTask()
    {
        if (board is null || saving)
        {
            return;
        }

        saving = true;

        try
        {
            newTask.ProjectId = board.ProjectId;
            newTask.BoardId = board.Id;
            newTask.OwnerId = userId;
            newTask.Status = ProjectTaskStatus.ToDo;
            newTask.DueDate = hasDueDate ? dueDate : null;

            var created = await Runner.RunAsync(
                () => TaskService.CreateTaskAsync(newTask),
                "Task created successfully!");

            if (created)
            {
                newTask = new ProjectTask
                {
                    ProjectId = board.ProjectId,
                    BoardId = board.Id,
                    OwnerId = userId
                };
                hasDueDate = false;
                dueDate = DateTime.Today;
                await LoadTasks();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private async Task UpdateTaskStatus(
        string taskId,
        ProjectTaskStatus status)
    {
        if (saving)
        {
            return;
        }

        saving = true;

        try
        {
            var updated = await Runner.RunAsync(
                () => TaskService.UpdateTaskStatusAsync(taskId, status),
                "Task moved to " + GetStatusLabel(status));

            if (updated)
            {
                await LoadTasks();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private void StartEditTask(ProjectTask task)
    {
        editingTaskId = task.Id;
        editTask = new ProjectTask
        {
            Id = task.Id,
            ProjectId = task.ProjectId,
            BoardId = task.BoardId,
            OwnerId = task.OwnerId,
            Title = task.Title,
            Description = task.Description ?? string.Empty,
            Status = task.Status,
            CreatedAt = task.CreatedAt
        };
        editHasDueDate = task.DueDate is not null;
        editDueDate = task.DueDate ?? DateTime.Today;
    }

    private void CancelEditTask()
    {
        editingTaskId = null;
    }

    private async Task UpdateTask()
    {
        if (editingTaskId is null || saving)
        {
            return;
        }

        saving = true;

        try
        {
            editTask.DueDate = editHasDueDate ? editDueDate : null;

            var updated = await Runner.RunAsync(
                () => TaskService.UpdateTaskAsync(editTask),
                "Task updated successfully!");

            if (updated)
            {
                editingTaskId = null;
                await LoadTasks();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private void StartDeleteTask(ProjectTask task)
    {
        deletingTaskId = task.Id;
    }

    private void CancelDeleteTask()
    {
        deletingTaskId = null;
    }

    private async Task DeleteTask()
    {
        if (deletingTaskId is null || deletingTask)
        {
            return;
        }

        deletingTask = true;

        try
        {
            var deleted = await Runner.RunAsync(
                () => TaskService.DeleteTaskAsync(deletingTaskId),
                "Task deleted successfully!");

            if (deleted)
            {
                deletingTaskId = null;
                await LoadTasks();
            }
        }
        finally
        {
            deletingTask = false;
        }
    }

    private void StartEditBoard()
    {
        if (board is null || savingBoard)
        {
            return;
        }

        editingBoard = true;
        editBoard = new Board
        {
            Id = board.Id,
            ProjectId = board.ProjectId,
            Name = board.Name,
            Description = board.Description ?? string.Empty
        };
    }

    private void CancelEditBoard()
    {
        editingBoard = false;
    }

    private async Task UpdateBoard()
    {
        if (board is null || savingBoard)
        {
            return;
        }

        savingBoard = true;

        try
        {
            var updated = await Runner.RunAsync(
                () => BoardService.UpdateBoardAsync(editBoard),
                "Board updated successfully!");

            if (updated)
            {
                editingBoard = false;
                board = await BoardService.GetBoardByIdAsync(board.Id);
            }
        }
        finally
        {
            savingBoard = false;
        }
    }

    private void StartDeleteBoard()
    {
        confirmingDeleteBoard = true;
    }

    private void CancelDeleteBoard()
    {
        confirmingDeleteBoard = false;
    }

    private async Task DeleteBoard()
    {
        if (board is null || deletingBoard)
        {
            return;
        }

        deletingBoard = true;

        try
        {
            var deleted = await Runner.RunAsync(
                () => BoardService.DeleteBoardAsync(board.Id),
                "Board deleted successfully!");

            if (deleted)
            {
                NavigationManager.NavigateTo($"/projects/{board.ProjectId}");
            }
        }
        finally
        {
            deletingBoard = false;
        }
    }

    private static string GetStatusLabel(ProjectTaskStatus status) => status switch
    {
        ProjectTaskStatus.ToDo => "To Do",
        ProjectTaskStatus.InProgress => "In Progress",
        _ => "Done",
    };

    private readonly record struct TaskColumn(
        string Label,
        ProjectTaskStatus Status,
        IReadOnlyList<ProjectTaskStatus> Moves);
}
