@* Public landing page: describes the app and links to sign-in / sign-up. *@
@page "/"

@layout EmptyLayout
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Team Project Planner - Organize, Assign, and Track Your Group Projects</PageTitle>

<div class="home-layout">

    <!-- Header -->
    <header class="home-header">
        <div class="home-brand">
            <span class="home-brand-logo"><img src="favicon.svg" alt="" /></span>
            <span class="home-brand-name">Team Planner</span>
        </div>
        <nav class="home-nav" aria-label="Authentication">
            @if (isAuthenticated)
            {
                <a href="/dashboard" class="home-btn home-btn-primary">Dashboard</a>
            }
            else
            {
                <a href="/auth/sign-in" class="home-btn home-btn-ghost">Sign In</a>
                <a href="/auth/sign-up" class="home-btn home-btn-primary">Sign Up</a>
            }
        </nav>
    </header>

    <!-- Hero -->
    <main class="home-main">
        <div class="home-hero-copy">
            <span class="home-badge">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path
                    d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z" />
                    <path d="M8 10v4" />
                    <path d="M12 10v2" />
                    <path d="M16 10v6" />
                </svg>
                Collaboration Hub
            </span>
            <h1 class="home-title">
                Organize, Assign, and Track Your
                <span class="home-title-gradient">Group Projects</span>
                in One Place
            </h1>
            <p class="home-description">
                A lightweight, collaborative project management planner designed for student teams.
                Keep track of tasks, assign ownership, monitor upcoming deadlines, and visualize
                progress in real-time.
            </p>
        </div>

        @if (isAuthenticated)
        {
            <div class="home-cta-row">
                <a href="/dashboard" class="home-btn home-btn-primary home-btn-lg">
                    Go to Dashboard
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
            </div>
        }
        else
        {
            <div class="home-cta-row">
                <a href="/auth/sign-up" class="home-btn home-btn-primary home-btn-lg">
                    Get Started
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14" />
                        <path d="m12 5 7 7-7 7" />
                    </svg>
                </a>
                <a href="/auth/sign-in" class="home-btn home-btn-outline home-btn-lg">Sign In to Workspace</a>
            </div>
        }

        <!-- Feature cards -->
        <div class="home-features">
            <div class="home-feature-card">
                <div class="home-feature-icon home-feature-icon-blue">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 10.656V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.344" />
                        <path d="m9 11 3 3L22 4" />
                    </svg>
                </div>
                <h3 class="home-feature-title">Task Accountability</h3>
                <p class="home-feature-text">
                    Create tasks with due dates, assign team owners, and transition states through
                    To Do, In Progress, and Done.
                </p>
            </div>
            <div class="home-feature-card">
                <div class="home-feature-icon home-feature-icon-green">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                        <path d="M16 3.128a4 4 0 0 1 0 7.744" />
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                        <circle cx="9" cy="7" r="4" />
                    </svg>
                </div>
                <h3 class="home-feature-title">Team Collaboration</h3>
                <p class="home-feature-text">
                    Invite members to your project workspace. See who is working on what task and
                    track active contributions.
                </p>
            </div>
            <div class="home-feature-card">
                <div class="home-feature-icon home-feature-icon-rose">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 6v6l4 2" />
                    </svg>
                </div>
                <h3 class="home-feature-title">Urgent Alert Warning</h3>
                <p class="home-feature-text">
                    Get visual indicators on your dashboard for tasks approaching deadlines in 48
                    hours or overdue tasks.
                </p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="home-footer">
        &copy; 2026 Team Project Planner. Built for collaborative student teams.
    </footer>

</div>

@code {
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
    }
}