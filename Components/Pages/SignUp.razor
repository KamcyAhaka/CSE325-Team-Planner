@* Sign-up page: creates a new account with the app's password policy. *@
@page "/auth/sign-up"
@page "/sign-up"
@page "/register"

@layout AuthLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject UserService UserService
@inject NavigationManager NavigationManager
@inject UiActionRunner Runner

<PageTitle>Sign Up - Team Project Planner</PageTitle>

<div class="auth-header">
    <h1 class="auth-title">Sign up to track your projects and tasks</h1>
</div>

<EditForm Model="@user" OnValidSubmit="@HandleSubmit" FormName="sign-up" Class="auth-form" novalidate>

    <DataAnnotationsValidator />

    <ValidationSummary class="form-validation" />

    <div class="form-field">
        <label for="name" class="form-label">Full Name</label>
        <LiveInputText id="name" class="form-input" @bind-Value="user.DisplayName" placeholder="Full Name" autocomplete="name" />
        <ValidationMessage For="() => user.DisplayName" />
    </div>

    <div class="form-field">
        <label for="email" class="form-label">Email</label>
        <LiveInputText id="email" type="email" class="form-input" @bind-Value="user.Email" placeholder="Email" autocomplete="email" />
        <ValidationMessage For="() => user.Email" />
    </div>

    <div class="form-field">
        <label for="password" class="form-label">Password</label>
        <LiveInputText id="password" type="password" class="form-input" @bind-Value="user.Password" placeholder="Password" autocomplete="new-password" />
        <ValidationMessage For="() => user.Password" />
        <p class="password-hint">
            Password must be at least 8 characters, contain one uppercase letter, one lowercase letter, and one number.
        </p>
    </div>

    <SubmitButton Text="Sign Up" IsBusy="@saving" />
</EditForm>

<div class="auth-footer">
    <span>Already have an account? </span>
    <a href="/auth/sign-in" class="auth-link">Sign in here</a>
</div>

<ToastHost />

@code {
    private AppUser user = new();
    private bool saving;

    private async Task HandleSubmit()
    {
        saving = true;
        try
        {
            var email = user.Email.Trim().ToLowerInvariant();
            var created = await Runner.RunAsync(async () =>
            {
                var existing = await UserService.GetByEmailAsync(email);
                if (existing is not null)
                {
                    throw new AppValidationException("User with this email already exists.");
                }

                await UserService.CreateUserAsync(email, user.Password, user.DisplayName.Trim());
            }, "Account created successfully!");

            if (created)
            {
                await Task.Delay(1200);
                NavigationManager.NavigateTo("/auth/sign-in?registered=true");
            }
        }
        finally
        {
            saving = false;
        }
    }
}
