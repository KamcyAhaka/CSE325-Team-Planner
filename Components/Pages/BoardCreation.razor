@page "/boards/create"

@rendermode InteractiveServer

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization

@using TeamProjectPlanner.Models

@using TeamProjectPlanner.Services

@inject BoardService BoardService

@inject ProjectService ProjectService

<PageTitle>Create Board</PageTitle>

<h1>Create Board</h1>

<p>Create a board for one of your projects.</p>

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}

<div class="card p-4 mt-4">
    <h2>Board Details</h2>

    <EditForm Model="@board"
              OnValidSubmit="@CreateBoard"
              OnInvalidSubmit="@HandleInvalidSubmit"
              FormName="create-board">

        <DataAnnotationsValidator />

        <ValidationSummary />

        <div class="mb-3">
            <label for="project" class="form-label">Project</label>

            <select id="project"
                    class="form-select"
                    @bind="board.ProjectId">
                <option value="">Select a project</option>

                @foreach (var project in projects)
                {
                    <option value="@project.Id">@project.Name</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="boardName" class="form-label">Board Name</label>

            <InputText id="boardName"
                       class="form-control"
                       @bind-Value="board.Name" />
        </div>

        <div class="mb-3">
            <label for="boardDescription" class="form-label">Description</label>

            <InputTextArea id="boardDescription"
                           class="form-control"
                           @bind-Value="board.Description" />
        </div>

        <button type="submit" class="btn btn-primary">
            Create Board
        </button>

    </EditForm>
</div>

@code {
    private List<Project> projects = new();
    private Board board = new();
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
    }

    private async Task CreateBoard()
    {
        await BoardService.CreateBoardAsync(board);

        successMessage = "Board created successfully!";

        board = new Board();
    }

    private void HandleInvalidSubmit()
    {
        successMessage = string.Empty;
    }
}