@page "/boards/create"
@layout Layout.DashboardLayout

@rendermode InteractiveServer

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using TeamProjectPlanner.Models
@using TeamProjectPlanner.Services

@inject BoardService BoardService
@inject ProjectService ProjectService

<PageTitle>Create Board</PageTitle>

<DashboardHeader Title="Create Board" Subtitle="
Create a board for one of your projects." />

<div class="board-page">

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="board-success" role="alert">
            @successMessage
        </div>
    }

    <div class="board-form-card">

        <h2 class="board-form-title">Board Details</h2>

        <EditForm Model="@board"
                  OnValidSubmit="@CreateBoard"
                  OnInvalidSubmit="@HandleInvalidSubmit"
                  FormName="create-board">

            <DataAnnotationsValidator />

            <div class="board-form">

                <ValidationSummary class="board-validation" />

                <div class="board-form-field">
                    <label for="project" class="board-form-label">
                        Project
                    </label>

                    <select id="project"
                            class="board-form-input"
                            @bind="board.ProjectId">
                        <option value="">Select a project</option>

                        @foreach (var project in projects)
                        {
                            <option value="@project.Id">
                                @project.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="board-form-field">
                    <label for="boardName" class="board-form-label">
                        Board Name
                    </label>

                    <InputText id="boardName"
                               class="board-form-input"
                               @bind-Value="board.Name" />
                </div>

                <div class="board-form-field">
                    <label for="boardDescription" class="board-form-label">
                        Description
                    </label>

                    <InputTextArea id="boardDescription"
                                   class="board-form-input board-form-textarea"
                                   @bind-Value="board.Description" />
                </div>

                <button type="submit" class="board-submit">
                    Create Board
                </button>

            </div>

        </EditForm>

    </div>

</div>

@code {
    private List<Project> projects = new();
    private Board board = new();
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
    }

    private async Task CreateBoard()
    {
        await BoardService.CreateBoardAsync(board);

        successMessage = "Board created successfully!";

        board = new Board();
    }

    private void HandleInvalidSubmit()
    {
        successMessage = string.Empty;
    }
}