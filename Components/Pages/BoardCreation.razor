@* Board creation page: lets the user add a new kanban board to one of their projects. *@
@page "/boards/create"
@layout DashboardLayout

@rendermode @(new InteractiveServerRenderMode(prerender: false))

@attribute [Authorize]

@using System.Security.Claims

@inject BoardService BoardService
@inject ProjectService ProjectService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UiActionRunner Runner

<PageTitle>Create Board</PageTitle>

<DashboardHeader Title="Create Board" Subtitle="
Create a board for one of your projects." />

<div class="board-page">

    <div class="form-card">

        <h2 class="form-title">Board Details</h2>

        <EditForm Model="@board"
                  OnValidSubmit="@CreateBoard"
                  FormName="create-board">

            <DataAnnotationsValidator />

            <div class="form">

                <ValidationSummary class="form-validation" />

                <div class="form-field">
                    <label for="project" class="form-label">
                        Project
                    </label>

                    <select id="project"
                            class="form-input"
                            @bind="board.ProjectId">
                        <option value="">Select a project</option>

                        @foreach (var project in projects)
                        {
                            <option value="@project.Id">
                                @project.Name
                            </option>
                        }
                    </select>
                    <ValidationMessage For="() => board.ProjectId" />
                </div>

                <div class="form-field">
                    <label for="boardName" class="form-label">
                        Board Name
                    </label>

                    <LiveInputText id="boardName"
                                   class="form-input"
                                   @bind-Value="board.Name" />
                    <ValidationMessage For="() => board.Name" />
                </div>

                <div class="form-field">
                    <label for="boardDescription" class="form-label">
                        Description
                    </label>

                    <LiveInputTextArea id="boardDescription"
                                       class="form-input form-textarea"
                                       @bind-Value="board.Description" />
                    <ValidationMessage For="() => board.Description" />
                </div>

                <SubmitButton Text="Create Board" IsBusy="@saving" />

            </div>

        </EditForm>

    </div>

</div>

<ToastHost />

@code {
    [SupplyParameterFromQuery]
    public string? projectId { get; set; }

    private List<Project> projects = new();
    private Board board = new();
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? string.Empty;

        projects = await ProjectService.GetProjectsForUserAsync(userId);

        if (!string.IsNullOrEmpty(projectId)
            && projects.Any(p => p.Id == projectId))
        {
            board.ProjectId = projectId;
        }
    }

    private async Task CreateBoard()
    {
        saving = true;
        try
        {
            var created = await Runner.RunAsync(
                () => BoardService.CreateBoardAsync(board),
                "Board created successfully!");

            if (created)
            {
                NavigationManager.NavigateTo($"/boards/{board.Id}");
            }
        }
        finally
        {
            saving = false;
        }
    }
}