@page "/projects/{projectId}"

@layout DashboardLayout

@rendermode InteractiveServer

@attribute [Authorize]

@using System.Security.Claims

@inject ProjectService ProjectService
@inject BoardService BoardService
@inject TaskService TaskService
@inject ProjectMemberService ProjectMemberService
@inject UserService UserService
@inject UiActionRunner Runner
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Project Workspace</PageTitle>

<DashboardHeader Title="Project Workspace" Subtitle="Manage the tasks and team for this project." />

<div class="project-workspace">
    @if (notFound)
    {
        <div class="project-empty">Project not found.</div>
    }
    else if (noAccess)
    {
        <div class="project-empty">You don't have access to this project.</div>
    }
    else if (project is null)
    {
        <div class="project-empty">Loading project...</div>
    }
    else
    {
        <div class="workspace-top-row">
            <a href="/dashboard" class="back-link">
                <span class="icon icon-arrow-left icon-sm"></span>
                Back to Dashboard
            </a>

            <a href="/boards/create?projectId=@project.Id" class="view-all-link">
                <span class="icon icon-plus icon-sm"></span>
                Create Board
            </a>
        </div>

        <div class="project-header-card">
            <div class="project-header-main">
                <div class="project-header-meta">
                    <span class="project-badge">@GetProjectStatus(project)</span>

                    <span class="project-date">
                        <span class="icon icon-calendar icon-xs"></span>
                        Due @project.EndDate.ToString("M/d/yyyy")
                    </span>
                </div>

                <h2>@project.Name</h2>
                <p class="project-header-desc">@project.Description</p>
            </div>

            <div class="project-header-side">
                <div class="project-members-header">
                    <span class="project-members-label">
                        Team Members (@team.Count)
                    </span>

                    @if (userId == project.OwnerId)
                    {
                        <button type="button"
                                class="btn btn-outline-secondary card-action-btn"
                                disabled="@(removingMemberBusy || addingMemberBusy)"
                                @onclick="ToggleAddMember">
                            @(showAddMember ? "Close" : "Add Member")
                        </button>
                    }
                </div>

                <div class="project-members">
                    @foreach (var person in team)
                    {
                        var name = GetUserName(person.UserId);

                        if (removingMember?.UserId == person.UserId)
                        {
                            <div class="member-row card-confirm">
                                <span class="avatar avatar-sm">
                                    @UserInfo.GetInitials(name)
                                </span>
                                <span class="member-name">@name</span>
                                <span>Remove from this project?</span>

                                <button type="button"
                                        class="btn btn-danger card-action-btn"
                                        disabled="@removingMemberBusy"
                                        @onclick="RemoveMember">
                                    @(removingMemberBusy ? "Removing..." : "Yes, remove")
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary card-action-btn"
                                        disabled="@removingMemberBusy"
                                        @onclick="CancelRemoveMember">
                                    No
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="member-row">
                                <span class="avatar avatar-sm">
                                    @UserInfo.GetInitials(name)
                                </span>
                                <span class="member-name">@name</span>
                                <span class="member-role">@person.Role</span>

                                @if (userId == project.OwnerId && person.MemberId is not null)
                                {
                                    <button type="button"
                                            class="btn btn-danger card-action-btn member-remove-btn"
                                            disabled="@removingMemberBusy"
                                            title="Remove @name from this project"
                                            @onclick="() => StartRemoveMember(person)">
                                        Remove
                                    </button>
                                }
                            </div>
                        }
                    }

                    @if (userId == project.OwnerId)
                    {
                        <div class="@(showAddMember ? "add-member-wrap open" : "add-member-wrap")">
                            <div class="add-member-form">
                                <div class="form-field">
                                    <label for="memberSearch" class="form-label">Search by name or email</label>
                                    <input id="memberSearch"
                                           type="text"
                                           class="form-input"
                                           placeholder="Type to search..."
                                           value="@addMemberQuery"
                                           disabled="@addingMemberBusy"
                                           @oninput="OnMemberSearchInput" />

                                    <div class="member-suggestions">
                                        @if (userSuggestions.Count > 0)
                                        {
                                            @foreach (var user in userSuggestions)
                                            {
                                                <button type="button"
                                                        class="member-suggestion"
                                                        disabled="@addingMemberBusy"
                                                        @onclick="() => SelectSuggestedUser(user)">
                                                    <span class="avatar avatar-sm">
                                                        @UserInfo.GetInitials(user.DisplayName)
                                                    </span>
                                                    <span class="member-name">@user.DisplayName</span>
                                                    <span class="member-role">@user.Email</span>
                                                </button>
                                            }
                                        }
                                        else if (addMemberQuery.Trim().Length >= 2 && !addingMemberBusy)
                                        {
                                            <p class="form-hint member-suggestion-empty">No users found. Select a suggestion above to enable Add.</p>
                                        }
                                    </div>
                                </div>

                                <div class="card-actions">
                                    <button type="button"
                                            class="btn btn-primary card-action-btn"
                                            disabled="@(selectedUser is null || addingMemberBusy)"
                                            @onclick="AddMember">
                                        @(addingMemberBusy ? "Adding..." : "Add")
                                    </button>
                                </div>

                                @if (!string.IsNullOrEmpty(addMemberError))
                                {
                                    <p class="form-validation">@addMemberError</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="workspace-stats">
            <div class="stat-card">
                <div class="stat-icon stat-icon-primary">
                    <span class="icon icon-square-check"></span>
                </div>

                <div class="stat-info">
                    <span class="stat-label">Project Progress</span>
                    <span class="stat-value">@ProgressPercent% Complete</span>
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-icon stat-icon-blue">
                    <span class="icon icon-folder"></span>
                </div>

                <div class="stat-info">
                    <span class="stat-label">Total Tasks</span>
                    <span class="stat-value">@tasks.Count Active: @ActiveCount</span>
                </div>
            </div>
        </div>

        <section class="task-board-section">
            <div class="section-header">
                <h3 class="section-title">Task Boards</h3>
            </div>

            @if (boards.Count == 0)
            {
                <div class="empty-state task-empty">
                    <span class="empty-icon icon-folder"></span>
                    <p>No boards yet. Create your first board to start organizing tasks.</p>
                </div>
            }
            else
            {
                <div class="projects-grid">
                    @foreach (var board in boards)
                    {
                        var boardTasks = tasks.Where(t => t.BoardId == board.Id).ToList();

                        if (editingBoardId == board.Id)
                        {
                            <article class="project-card">
                                <h3 class="project-name">Edit Board</h3>

                                <EditForm Model="@editBoard" OnValidSubmit="@UpdateBoard" FormName="edit-board">

                                    <DataAnnotationsValidator />

                                    <ValidationSummary class="form-validation" />

                                    <div class="form-field">
                                        <label for="editBoardName" class="form-label">Board Name</label>
                                        <LiveInputText id="editBoardName" class="form-input" @bind-Value="editBoard.Name" />
                                        <ValidationMessage For="() => editBoard.Name" />
                                    </div>

                                    <div class="form-field">
                                        <label for="editBoardDescription" class="form-label">Description</label>
                                        <LiveInputTextArea id="editBoardDescription" class="form-input form-textarea"
                                                           @bind-Value="editBoard.Description" />
                                        <ValidationMessage For="() => editBoard.Description" />
                                    </div>

                                    <div class="card-actions">
                                        <SubmitButton Text="Save Changes"
                                                      Class="btn btn-primary card-action-btn"
                                                      IsBusy="@savingBoard" />
                                        <button type="button"
                                                class="btn btn-outline-secondary card-action-btn"
                                                disabled="@savingBoard"
                                                @onclick="CancelEditBoard">
                                            Cancel
                                        </button>
                                    </div>

                                </EditForm>
                            </article>
                        }
                        else if (deletingBoardId == board.Id)
                        {
                            <article class="project-card">
                                <h3 class="project-name">@board.Name</h3>

                                <p class="project-desc">
                                    Delete this board? Its tasks will be deleted too.
                                </p>

                                <div class="card-confirm">
                                    <button type="button"
                                            class="btn btn-danger card-action-btn"
                                            disabled="@deletingBoard"
                                            @onclick="DeleteBoard">
                                        @(deletingBoard ? "Deleting..." : "Yes, delete")
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-secondary card-action-btn"
                                            disabled="@deletingBoard"
                                            @onclick="CancelDeleteBoard">
                                        No
                                    </button>
                                </div>
                            </article>
                        }
                        else
                        {
                            <article class="project-card">
                                <div class="project-card-top">
                                    <span class="project-badge">@boardTasks.Count</span>
                                    <span class="project-date">tasks</span>
                                </div>

                                <h3 class="project-name">@board.Name</h3>

                                @if (!string.IsNullOrEmpty(board.Description))
                                {
                                    <p class="project-desc">@board.Description</p>
                                }

                                <div class="card-actions">
                                    <a href="/boards/@board.Id" class="btn btn-primary card-action-btn">
                                        Open Board
                                    </a>
                                    <button type="button"
                                            class="btn btn-outline-secondary card-action-btn"
                                            @onclick="() => StartEditBoard(board)">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger card-action-btn"
                                            @onclick="() => StartDeleteBoard(board)">
                                        Delete
                                    </button>
                                </div>
                            </article>
                        }
                    }
                </div>
            }

        </section>
    }

    <ToastHost />
</div>

@code {
    [Parameter]
    public string projectId { get; set; } = string.Empty;

    private Project? project;
    private List<Board> boards = new();
    private List<ProjectTask> tasks = new();
    private List<TeamPerson> team = new();
    private Dictionary<string, AppUser> usersById = new();
    private bool notFound;
    private bool noAccess;
    private string userId = string.Empty;

    private string? editingBoardId;
    private Board editBoard = new();
    private bool savingBoard;

    private string? deletingBoardId;
    private bool deletingBoard;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? string.Empty;

        project = await ProjectService.GetProjectByIdAsync(projectId);

        if (project is null)
        {
            notFound = true;
            return;
        }

        var members = await ProjectMemberService.GetMembersByProjectAsync(projectId);

        team = new List<TeamPerson> { new(project.OwnerId, null, "Owner") };

        foreach (var member in members)
        {
            if (member.UserId != project.OwnerId)
            {
                team.Add(new(member.UserId, member.Id, GetRoleLabel(member.Role)));
            }
        }

        noAccess = project.OwnerId != userId
            && !members.Any(m => m.UserId == userId);

        if (noAccess)
        {
            return;
        }

        await LoadTasks();

        var ids = team.Select(p => p.UserId)
            .Concat(tasks.Select(t => t.OwnerId))
            .ToList();

        usersById = await UserService.GetUsersByIdsAsync(ids);
    }

    private async Task LoadTasks()
    {
        if (project is not null)
        {
            boards = await BoardService.GetBoardsByProjectAsync(project.Id);
            tasks = await TaskService.GetTasksByProjectAsync(project.Id);
        }
    }

    private void StartEditBoard(Board board)
    {
        editingBoardId = board.Id;
        editBoard = new Board
        {
            Id = board.Id,
            ProjectId = project!.Id,
            Name = board.Name,
            Description = board.Description ?? string.Empty
        };
    }

    private void CancelEditBoard()
    {
        editingBoardId = null;
    }

    private async Task UpdateBoard()
    {
        if (editingBoardId is null || savingBoard)
        {
            return;
        }

        savingBoard = true;

        try
        {
            var updated = await Runner.RunAsync(
                () => BoardService.UpdateBoardAsync(editBoard),
                "Board updated successfully!");

            if (updated)
            {
                editingBoardId = null;
                await LoadTasks();
            }
        }
        finally
        {
            savingBoard = false;
        }
    }

    private void StartDeleteBoard(Board board)
    {
        deletingBoardId = board.Id;
    }

    private void CancelDeleteBoard()
    {
        deletingBoardId = null;
    }

    private async Task DeleteBoard()
    {
        if (deletingBoardId is null || deletingBoard)
        {
            return;
        }

        deletingBoard = true;

        try
        {
            var deleted = await Runner.RunAsync(
                () => BoardService.DeleteBoardAsync(deletingBoardId),
                "Board deleted successfully!");

            if (deleted)
            {
                deletingBoardId = null;
                await LoadTasks();
            }
        }
        finally
        {
            deletingBoard = false;
        }
    }

    private TeamPerson? removingMember;
    private bool removingMemberBusy;

    private bool showAddMember;
    private string addMemberQuery = string.Empty;
    private List<AppUser> userSuggestions = new();
    private AppUser? selectedUser;
    private string? addMemberError;
    private bool addingMemberBusy;
    private CancellationTokenSource? searchCts;

    private void StartRemoveMember(TeamPerson person)
    {
        if (person.MemberId is null || removingMemberBusy)
        {
            return;
        }

        removingMember = person;
    }

    private void CancelRemoveMember()
    {
        removingMember = null;
    }

    private async Task RemoveMember()
    {
        if (removingMember?.MemberId is null || removingMemberBusy)
        {
            return;
        }

        removingMemberBusy = true;

        try
        {
            var removed = await Runner.RunAsync(
                () => ProjectMemberService.RemoveMemberAsync(removingMember.MemberId!),
                "Member removed successfully!");

            if (removed)
            {
                removingMember = null;
                await LoadTeam();
            }
        }
        finally
        {
            removingMemberBusy = false;
        }
    }

    private async Task LoadTeam()
    {
        if (project is null)
        {
            return;
        }

        var members = await ProjectMemberService.GetMembersByProjectAsync(project.Id);

        team = new List<TeamPerson> { new(project.OwnerId, null, "Owner") };

        foreach (var member in members)
        {
            if (member.UserId != project.OwnerId)
            {
                team.Add(new(member.UserId, member.Id, GetRoleLabel(member.Role)));
            }
        }

        var ids = team.Select(p => p.UserId).ToList();
        usersById = await UserService.GetUsersByIdsAsync(ids);
    }

    private void ToggleAddMember()
    {
        showAddMember = !showAddMember;

        if (!showAddMember)
        {
            ResetAddMemberForm();
        }
    }

    private void ResetAddMemberForm()
    {
        searchCts?.Cancel();
        addMemberQuery = string.Empty;
        userSuggestions = new List<AppUser>();
        selectedUser = null;
        addMemberError = null;
    }

    private async Task OnMemberSearchInput(ChangeEventArgs e)
    {
        addMemberQuery = e.Value?.ToString() ?? string.Empty;
        selectedUser = null;
        addMemberError = null;

        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        try
        {
            await Task.Delay(300, token);
            await SearchUsers(token);
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke superseded this search.
        }
    }

    private async Task SearchUsers(CancellationToken token)
    {
        if (addMemberQuery.Trim().Length < 2)
        {
            userSuggestions = new List<AppUser>();
            StateHasChanged();
            return;
        }

        var results = await UserService.SearchUsersAsync(addMemberQuery);

        var teamIds = team.Select(p => p.UserId).ToHashSet();
        userSuggestions = results.Where(u => !teamIds.Contains(u.Id)).ToList();

        if (token.IsCancellationRequested)
        {
            return;
        }

        StateHasChanged();
    }

    private void SelectSuggestedUser(AppUser user)
    {
        selectedUser = user;
        addMemberQuery = user.Email;
        userSuggestions = new List<AppUser>();
        addMemberError = null;
    }

    private async Task AddMember()
    {
        if (project is null || selectedUser is null || addingMemberBusy)
        {
            return;
        }

        addingMemberBusy = true;

        try
        {
            var added = await Runner.RunAsync(
                () => ProjectMemberService.AddMemberAsync(new ProjectMember
                {
                    ProjectId = project.Id,
                    UserId = selectedUser.Id,
                    Role = ProjectRole.Member,
                    JoinedAt = DateTime.UtcNow
                }),
                "Member added successfully!");

            if (added)
            {
                ResetAddMemberForm();
                await LoadTeam();
            }
        }
        finally
        {
            addingMemberBusy = false;
        }
    }

    private int ProgressPercent =>
        tasks.Count == 0
            ? 0
            : (int)Math.Round(100.0 * tasks.Count(t => t.Status == ProjectTaskStatus.Done) / tasks.Count);

    private int ActiveCount =>
        tasks.Count(t => t.Status != ProjectTaskStatus.Done);

    private string GetUserName(string id) =>
        usersById.TryGetValue(id, out var user)
            ? user.DisplayName
            : "Unknown";

    private static string GetProjectStatus(Project p)
    {
        var now = DateTime.Now;

        if (p.EndDate < now)
        {
            return "completed";
        }

        if (p.StartDate > now)
        {
            return "planning";
        }

        return "active";
    }

    private static string GetRoleLabel(ProjectRole role) => role switch
    {
        ProjectRole.Owner => "Owner",
        _ => "Member",
    };

    private sealed record TeamPerson(
        string UserId,
        string? MemberId,
        string Role);
}
