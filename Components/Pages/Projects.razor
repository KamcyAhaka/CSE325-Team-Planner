@* Projects page: lists the current user's projects (owned and as a member)
   with completion progress, and lets the user create a new project. *@
@page "/projects"
@layout DashboardLayout

@rendermode InteractiveServer

@attribute [Authorize]

@using System.Security.Claims

@inject ProjectService ProjectService
@inject UiActionRunner Runner
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Projects</PageTitle>

<DashboardHeader Title="Projects" Subtitle="
Create and manage your projects." />

<div class="project-page">

    <div class="form-card">

        <h2 class="form-title">Create Project</h2>

        <EditForm Model="@project" OnValidSubmit="@CreateProject" FormName="create-project">

            <DataAnnotationsValidator />

            <div class="form">

                <ValidationSummary class="form-validation" />

                <div class="form-field">
                    <label for="projectName" class="form-label">
                        Project Name
                    </label>

                    <LiveInputText id="projectName" class="form-input" @bind-Value="project.Name" />
                    <ValidationMessage For="() => project.Name" />
                </div>

                <div class="form-field">
                    <label for="projectDescription" class="form-label">
                        Description
                    </label>

                    <LiveInputTextArea id="projectDescription" class="form-input form-textarea"
                                       @bind-Value="project.Description" />
                    <ValidationMessage For="() => project.Description" />
                </div>

                <div class="project-date-row">

                    <div class="form-field">
                        <label for="startDate" class="form-label">
                            Start Date
                        </label>

                        <InputDate id="startDate" class="form-input" @bind-Value="project.StartDate" />
                    </div>

                    <div class="form-field">
                        <label for="endDate" class="form-label">
                            End Date
                        </label>

                        <InputDate id="endDate" class="form-input" @bind-Value="project.EndDate" />
                        <ValidationMessage For="() => project.EndDate" />
                    </div>

                </div>

                <SubmitButton Text="Create Project" IsBusy="@saving" />

            </div>

        </EditForm>

    </div>

    @if (projects.Count > 0)
    {
        <div class="project-list">

            <h2 class="project-list-title">Projects</h2>

            <div class="project-grid">

                @foreach (var item in projects)
                {
                    if (editingId == item.Id)
                    {
                        <div class="project-list-card">

                            <h3 class="project-list-card-title">Edit Project</h3>

                            <EditForm Model="@editProject" OnValidSubmit="@UpdateProject" FormName="edit-project">

                                <DataAnnotationsValidator />

                                <ValidationSummary class="form-validation" />

                                <div class="form-field">
                                    <label for="editName" class="form-label">Project Name</label>
                                    <LiveInputText id="editName" class="form-input" @bind-Value="editProject.Name" />
                                    <ValidationMessage For="() => editProject.Name" />
                                </div>

                                <div class="form-field">
                                    <label for="editDescription" class="form-label">Description</label>
                                    <LiveInputTextArea id="editDescription" class="form-input form-textarea"
                                                       @bind-Value="editProject.Description" />
                                    <ValidationMessage For="() => editProject.Description" />
                                </div>

                                <div class="project-date-row">

                                    <div class="form-field">
                                        <label for="editStartDate" class="form-label">Start Date</label>
                                        <InputDate id="editStartDate" class="form-input" @bind-Value="editProject.StartDate" />
                                    </div>

                                    <div class="form-field">
                                        <label for="editEndDate" class="form-label">End Date</label>
                                        <InputDate id="editEndDate" class="form-input" @bind-Value="editProject.EndDate" />
                                        <ValidationMessage For="() => editProject.EndDate" />
                                    </div>

                                </div>

                                <div class="card-actions">
                                    <SubmitButton Text="Save Changes"
                                                  Class="btn btn-primary card-action-btn"
                                                  IsBusy="@saving" />
                                    <button type="button"
                                            class="btn btn-outline-secondary card-action-btn"
                                            disabled="@saving"
                                            @onclick="CancelEdit">
                                        Cancel
                                    </button>
                                </div>

                            </EditForm>

                        </div>
                    }
                    else if (deletingId == item.Id)
                    {
                        <div class="project-list-card">

                            <h3 class="project-list-card-title">@item.Name</h3>

                            <p class="project-list-card-description">
                                Delete this project? Its boards and tasks will be deleted too.
                            </p>

                            <div class="card-confirm">
                                <button type="button"
                                        class="btn btn-danger card-action-btn"
                                        disabled="@deleting"
                                        @onclick="DeleteProject">
                                    @(deleting ? "Deleting..." : "Yes, delete")
                                </button>
                                <button type="button"
                                        class="btn btn-outline-secondary card-action-btn"
                                        disabled="@deleting"
                                        @onclick="CancelDelete">
                                    No
                                </button>
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="project-list-card">

                            <h3 class="project-list-card-title">
                                @item.Name
                            </h3>

                            <p class="project-list-card-description">
                                @item.Description
                            </p>

                            <p class="project-list-card-date">
                                <strong>Start:</strong>
                                @item.StartDate.ToString("M/d/yyyy")
                            </p>

                            <p class="project-list-card-date">
                                <strong>End:</strong>
                                @item.EndDate.ToString("M/d/yyyy")
                            </p>

                            <div class="card-actions">
                                <a class="btn btn-primary card-action-btn"
                                   href="/projects/@item.Id">
                                    Open
                                </a>
                                @if (item.OwnerId == currentUserId)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary card-action-btn"
                                            @onclick="() => StartEdit(item)">
                                        Edit
                                    </button>
                                    <button type="button"
                                            class="btn btn-danger card-action-btn"
                                            @onclick="() => StartDelete(item)">
                                        Delete
                                    </button>
                                }
                            </div>

                        </div>
                    }
                }

            </div>

        </div>
    }
    else
    {
        <div class="project-empty">
            No projects have been created yet.
        </div>
    }

</div>

<ToastHost />

@code {
    private Project project = new() { StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(1) };
    private List<Project> projects = new();
    private bool saving;

    private string? editingId;
    private Project editProject = new();

    private string? deletingId;
    private bool deleting;

    private string currentUserId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        currentUserId = authenticationState.User
            .FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        await ReloadProjects();
    }

    private async Task CreateProject()
    {
        var authenticationState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var user = authenticationState.User;

        project.OwnerId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        saving = true;
        try
        {
            var created = await Runner.RunAsync(
                () => ProjectService.CreateProjectAsync(project),
                "Project created successfully!");

            if (created)
            {
                project = new Project { StartDate = DateTime.Today, EndDate = DateTime.Today.AddMonths(1) };
                await ReloadProjects();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private void StartEdit(Project item)
    {
        editingId = item.Id;
        editProject = new Project
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description ?? string.Empty,
            StartDate = item.StartDate,
            EndDate = item.EndDate
        };
    }

    private void CancelEdit()
    {
        editingId = null;
    }

    private async Task UpdateProject()
    {
        if (editingId is null || saving)
        {
            return;
        }

        saving = true;

        try
        {
            var updated = await Runner.RunAsync(
                () => ProjectService.UpdateProjectAsync(editProject, currentUserId),
                "Project updated successfully!");

            if (updated)
            {
                editingId = null;
                await ReloadProjects();
            }
        }
        finally
        {
            saving = false;
        }
    }

    private void StartDelete(Project item)
    {
        deletingId = item.Id;
    }

    private void CancelDelete()
    {
        deletingId = null;
    }

    private async Task DeleteProject()
    {
        if (deletingId is null || deleting)
        {
            return;
        }

        deleting = true;

        try
        {
            var deleted = await Runner.RunAsync(
                () => ProjectService.DeleteProjectAsync(deletingId, currentUserId),
                "Project deleted successfully!");

            if (deleted)
            {
                deletingId = null;
                await ReloadProjects();
            }
        }
        finally
        {
            deleting = false;
        }
    }

    private async Task ReloadProjects()
    {
        var authenticationState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var userId = authenticationState.User
            .FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        projects = await ProjectService.GetProjectsForUserAsync(userId);
    }
}