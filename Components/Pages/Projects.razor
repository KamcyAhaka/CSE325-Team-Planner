@page "/projects"
@layout DashboardLayout
@rendermode InteractiveServer

@attribute [Authorize]

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TeamProjectPlanner.Models
@using TeamProjectPlanner.Services

@inject ProjectService ProjectService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Projects</PageTitle>

<div class="project-page">

    <div class="project-page-header">
        <h1 class="project-page-title">Projects</h1>

        <p class="project-page-subtitle">
            Create and manage your projects.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="project-success" role="alert">
            @successMessage
        </div>
    }

    <div class="project-form-card">

        <h2 class="project-form-title">Create Project</h2>

        <EditForm Model="@project"
                  OnValidSubmit="@CreateProject"
                  FormName="create-project">

            <div class="project-form">

                <div class="project-form-field">
                    <label for="projectName" class="project-form-label">
                        Project Name
                    </label>

                    <InputText id="projectName"
                               class="project-form-input"
                               @bind-Value="project.Name" />
                </div>

                <div class="project-form-field">
                    <label for="projectDescription" class="project-form-label">
                        Description
                    </label>

                    <InputTextArea id="projectDescription"
                                   class="project-form-input project-form-textarea"
                                   @bind-Value="project.Description" />
                </div>

                <div class="project-date-row">

                    <div class="project-form-field">
                        <label for="startDate" class="project-form-label">
                            Start Date
                        </label>

                        <InputDate id="startDate"
                                   class="project-form-input"
                                   @bind-Value="project.StartDate" />
                    </div>

                    <div class="project-form-field">
                        <label for="endDate" class="project-form-label">
                            End Date
                        </label>

                        <InputDate id="endDate"
                                   class="project-form-input"
                                   @bind-Value="project.EndDate" />
                    </div>

                </div>

                <button type="submit" class="project-submit">
                    Create Project
                </button>

            </div>

        </EditForm>

    </div>

    @if (projects.Count > 0)
    {
        <div class="project-list">

            <h2 class="project-list-title">Projects</h2>

            <div class="project-grid">

                @foreach (var item in projects)
                {
                    <div class="project-card">

                        <h3 class="project-card-title">
                            @item.Name
                        </h3>

                        <p class="project-card-description">
                            @item.Description
                        </p>

                        <p class="project-card-date">
                            <strong>Start:</strong>
                            @item.StartDate.ToString("MMM dd, yyyy")
                        </p>

                        <p class="project-card-date">
                            <strong>End:</strong>
                            @item.EndDate.ToString("MMM dd, yyyy")
                        </p>

                    </div>
                }

            </div>

        </div>
    }
    else
    {
        <div class="project-empty">
            No projects have been created yet.
        </div>
    }

</div>

@code {
    private Project project = new();
    private List<Project> projects = new();
    private string successMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        projects = await ProjectService.GetProjectsAsync();
    }

    private async Task CreateProject()
    {
        var authenticationState = await AuthenticationStateProvider
            .GetAuthenticationStateAsync();

        var user = authenticationState.User;

        project.OwnerId = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        await ProjectService.CreateProjectAsync(project);

        successMessage = "Project created successfully!";

        project = new Project();
        projects = await ProjectService.GetProjectsAsync();
    }
}