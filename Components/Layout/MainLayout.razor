@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <AppErrorBoundary>
                @Body
            </AppErrorBoundary>
        </article>
    </main>
</div>

<ToastHost @rendermode="InteractiveServer" />

<div id="blazor-error-ui" role="alert">
    <span>Something went wrong and the page stopped responding.</span>
    <a href="" class="reload">Reload page</a>
    <a class="dismiss" aria-label="Dismiss">&times;</a>
</div>
