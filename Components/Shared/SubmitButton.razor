@* Submit button that disables itself and shows a spinner while work is in progress,
   so users get feedback and can't submit twice. *@
<button type="submit"
        class="@Class"
        disabled="@(IsBusy || Disabled)"
        aria-busy="@(IsBusy ? "true" : "false")"
        @attributes="AdditionalAttributes">
    @if (IsBusy)
    {
        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
        <span>@BusyText</span>
    }
    else
    {
        <span>@Text</span>
    }
</button>

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string BusyText { get; set; } = "Saving...";

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Class { get; set; } = "btn btn-primary";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
