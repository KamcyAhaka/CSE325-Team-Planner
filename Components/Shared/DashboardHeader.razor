@* Reusable page header showing title, optional subtitle and the authenticated user's avatar/name/email. *@
@inherits UserAwareComponent

<header class="dashboard-header">
    <div>
        <h1 class="dashboard-title">@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="dashboard-subtitle">@Subtitle</p>
        }
    </div>

    <div class="header-user">
        <div class="avatar avatar-sm">@Initials</div>
        <div>
            <div class="header-user-name">@DisplayName</div>
            <div class="header-user-email">@Email</div>
        </div>
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
}
