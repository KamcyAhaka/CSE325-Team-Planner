@* Single-line text input that updates its bound value on every keystroke
   (oninput) instead of only on blur, so live search and validation work. *@
@inherits InputBase<string>
@using System.Diagnostics.CodeAnalysis

<input @bind="CurrentValueAsString" @bind:event="oninput" class="@CssClass" @attributes="AdditionalAttributes" />

@code {
    protected override bool TryParseValueFromString(string? value, [MaybeNullWhen(false)] out string result, [NotNullWhen(false)] out string? validationErrorMessage)
    {
        result = value ?? string.Empty;
        validationErrorMessage = null;
        return true;
    }
}
